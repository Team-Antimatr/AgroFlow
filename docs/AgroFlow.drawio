="1"><mxGeometry x="560" y="305" width="480" height="100" as="geometry" /></mxCell><mxCell id="tab3_box" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Tab 3: Offline Demo Sandbox&lt;/b&gt;&lt;br/&gt;&amp;bull; Offline clone of Tab 2 for exhibition judges&lt;br/&gt;&amp;bull; Scenarios: Saline (850 ppm) vs Fresh (180 ppm)&lt;br/&gt;&amp;bull; Interactive sliders for live audience demo" vertex="1"><mxGeometry x="1100" y="305" width="430" height="100" as="geometry" /></mxCell><mxCell id="e_sync1" parent="1" edge="1" source="fb_box" target="tab2_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#4338CA;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" value="Firebase Realtime Sync"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_sync2" parent="1" edge="1" source="ai_box" target="tab2_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#4338CA;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Agronomist Inferences"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t3_bg" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Helvetica;fontSize=13;fontStyle=1;align=left;spacingLeft=16;strokeWidth=1.5;shadow=0;fillColor=#FFFBEB;strokeColor=#FBBF24;fontColor=#B45309;" value="&lt;b&gt;IoT HARDWARE CONTROLLER LAYER (Arduino Uno)&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="445" width="1520" height="150" as="geometry" /></mxCell><mxCell id="mcu_box" parent="1" style="rounded=1;arcSize=10;wh