Loop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D97706;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#B45309;fontStyle=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Switching Relay"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e_bt" parent="1" edge="1" source="c_bt" target="c_uno" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#4338CA;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Pins 10 (RX) &amp;amp; 11 (TX)"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c_table" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Pin Reference Summary Table:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;A0:&lt;/b&gt; TDS Impurity Sensor &amp;nbsp;|&amp;nbsp; &lt;b&gt;A1:&lt;/b&gt; Soil Moisture Sensor&lt;br/&gt;&amp;bull; &lt;b&gt;Pin 3:&lt;/b&gt; SG90 Servo Diverter &amp;nbsp;|&amp;nbsp; &lt;b&gt;Pin 7:&lt;/b&gt; Relay IN1 (Pump 1) &amp;nbsp;|&amp;nbsp; &lt;b&gt;Pin 8:&lt;/b&gt; Relay IN2 (Dosing Pump)&lt;br/&gt;&amp;bull; &lt;b&gt;Pin 10 / 11:&lt;/b&gt; Bluetooth HC-05 RX/TX &amp;nbsp;|&amp;nbsp; &lt;b&gt;Wokwi Ready:&lt;/b&gt; Verified virtual circuit prototyping" vertex="1"><mxGeometry x="150" y="540" width="1300" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-mobile-app" name="4. Mobile App UI Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="850" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=16;fontColor=#FFFFFF;fontStyle=1;align=center;shadow=0;" value="&lt;b&gt;AgroFlow AI &amp;mdash; Android Mobile App Navigation &amp;amp; UI Architecture&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;font-weight:normal;color:#94A3B8;'&gt;Three Main Tabs: Daily Schedules &amp;bull; Live Telemetry Diagnostic &amp;bull; Offline Exhibition Sandbox&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="20" width="1520" height="55" as="geometry" /></mxCell><mxCell id="tab1_hdr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Helvetica;fontSize=13;fontStyle=1;align=left;spacingLeft=16;strokeWidth=1.5;shadow=0;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1D4ED8;" value="&lt;b&gt;TAB 1: SMART SCHEDULER&lt;/b&gt;" vertex="1"><mxGeometry x="100" y="100" width="420" height="40" as="geometry" /></mxCell><mxCell id="t1_card" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Daily AI Schedule Cards:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Zone 1:&lt;/b&gt; 07:30 AM &amp;bull; 4.5 L + 30 mL NPK&lt;br/&gt;&amp;bull; &lt;b&gt;Zone 2:&lt;/b&gt; 11:30 AM &amp;bull; Scheduled&lt;br/&gt;&amp;bull; &lt;b&gt;Zone 3:&lt;/b&gt; 05:30 PM &amp;bull; Scheduled&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Actions &amp;amp; Controls:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;[START BUTTON]:&lt;/b&gt; Wireless Bluetooth trigger&lt;br/&gt;&amp;bull; &lt;b&gt;Custom Schedule:&lt;/b&gt; Time picker, zone &amp;amp; dose&lt;br/&gt;&amp;bull; &lt;b&gt;Pre-Demo Card:&lt;/b&gt; Active timer with 10s cooldown" vertex="1"><mxGeometry x="100" y="150" width="420" height="260" as="geometry" /></mxCell><mxCell id="tab2_hdr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Helvetica;fontSize=13;fontStyle=1;align=left;spacingLeft=16;strokeWidth=1.5;shadow=0;fillColor=#F0FDF4;strokeColor=#4ADE80;fontColor=#15803D;" value="&lt;b&gt;TAB 2: AGROTDS LIVE DASHBOARD&lt;/b&gt;" vertex="1"><mxGeometry x="580" y="100" width="440" height="40" as="geometry" /></mxCell><mxCell id="t2_card" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;5 Real-Time Diagnostic Widgets:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Water Purity:&lt;/b&gt; 850 ppm &lt;span style='color:#E11D48;font-weight:bold;'&gt;[RED: High Salinity]&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; AI Risk: High osmotic root burn risk&lt;br/&gt;2. &lt;b&gt;Bio-Filtration:&lt;/b&gt; 1.8 L/min &amp;bull; Gate: DIVERTED (90&amp;deg;)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Efficiency: 76% (850 &amp;rarr; 200 ppm)&lt;br/&gt;3. &lt;b&gt;AI Soil Score:&lt;/b&gt; 28% Moisture &amp;bull; Score 64/100&lt;br/&gt;4. &lt;b&gt;Mechanism Signals:&lt;/b&gt; Servo 90&amp;deg; &amp;bull; Pump ON &amp;bull; Dosing ON&lt;br/&gt;5. &lt;b&gt;AI Agronomist Text:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&quot;Salinity elevated (850 ppm). Auto-routed to bio-filter before nutrient dosing. Soil at 28%; cycle will restore optimal moisture in 45s.&quot;&lt;/i&gt;" vertex="1"><mxGeometry x="580" y="150" width="440" height="260" as="geometry" /></mxCell><mxCell id="tab3_hdr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Helvetica;fontSize=13;fontStyle=1;align=left;spacingLeft=16;strokeWidth=1.5;shadow=0;fillColor=#FAF5FF;strokeColor=#C084FC;fontColor=#6B21A8;" value="&lt;b&gt;TAB 3: OFFLINE DEMO SANDBOX&lt;/b&gt;" vertex="1"><mxGeometry x="1080" y="100" width="420" height="40" as="geometry" /></mxCell><mxCell id="t3_card" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Exhibition Evaluation Sandbox:&lt;/b&gt;&lt;br/&gt;&amp;bull; Full offline mirror of Tab 2 for judges&lt;br/&gt;&amp;bull; &lt;b&gt;Preset Scenarios:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; &lt;i&gt;Scenario A:&lt;/i&gt; High Salinity (850 ppm, Filter Active)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; &lt;i&gt;Scenario B:&lt;/i&gt; Freshwater (180 ppm, Bypass)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; &lt;i&gt;Scenario C:&lt;/i&gt; Drought Stress (12% Moisture)&lt;br/&gt;&amp;bull; &lt;b&gt;Interactive Sliders:&lt;/b&gt; Live TDS &amp;amp; moisture tuning" vertex="1"><mxGeometry x="1080" y="150" width="420" height="260" as="geometry" /></mxCell><mxCell id="p4_e1" parent="1" edge="1" source="t1_card" target="t2_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#4338CA;fontStyle=1;" value="START Trigger streams telemetry"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_e2" parent="1" edge="1" source="t2_card" target="t3_card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#475569;" value="Offline Clone Mode"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>