t;Step-by-Step Fluidic Journey from Groundwater Source to Crop Root Zone&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="20" width="1520" height="55" as="geometry" /></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;1. Groundwater Source&lt;/b&gt;&lt;br/&gt;Reservoir 1&lt;br/&gt;High TDS / Mineral Salinity&lt;br/&gt;&lt;b&gt;Submersible Pump (Pin 7)&lt;/b&gt;" vertex="1"><mxGeometry x="60" y="140" width="200" height="110" as="geometry" /></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#14532D;" value="&lt;b&gt;2. Real-Time TDS Test&lt;/b&gt;&lt;br/&gt;Inline Chamber&lt;br/&gt;Salinity Check in ppm&lt;br/&gt;&lt;b&gt;Analog Signal (Pin A0)&lt;/b&gt;" vertex="1"><mxGeometry x="330" y="140" width="200" height="110" as="geometry" /></mxCell><mxCell id="s3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;" value="&lt;b&gt;3. SG90 Servo Diverter&lt;/b&gt;&lt;br/&gt;Automated 2-Way Gate&lt;br/&gt;&lt;b&gt;PWM Actuation (Pin 3)&lt;/b&gt;&lt;br/&gt;Threshold: 500 ppm" vertex="1"><mxGeometry x="600" y="140" width="200" height="110" as="geometry" /></mxCell><mxCell id="s4_f" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFF1F2;strokeColor=#F43F5E;fontColor=#881337;" value="&lt;b&gt;4A. Bio-Sand Filter (90&amp;deg;)&lt;/b&gt;&lt;br/&gt;Activated Charcoal + Sand&lt;br/&gt;Removes Salts &amp;amp; Odor&lt;br/&gt;&lt;b&gt;850 &amp;rarr; 200 ppm (76% reduction)&lt;/b&gt;" vertex="1"><mxGeometry x="880" y="100" width="240" height="95" as="geometry" /></mxCell><mxCell id="s4_b" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;4B. Direct Clean Bypass (0&amp;deg;)&lt;/b&gt;&lt;br/&gt;Safe Water (&amp;le; 500 ppm)&lt;br/&gt;Preserves filter bed life" vertex="1"><mxGeometry x="880" y="230" width="240" height="80" as="geometry" /></mxCell><mxCell id="s5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;" value="&lt;b&gt;5. Fertigation Unit&lt;/b&gt;&lt;br/&gt;Reservoir 2: NPK Liquid&lt;br/&gt;&lt;b&gt;Dosing Pump (Pin 8)&lt;/b&gt;&lt;br/&gt;Injects 30 mL/cycle" vertex="1"><mxGeometry x="1200" y="140" width="200" height="110" as="geometry" /></mxCell><mxCell id="s6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#14532D;" value="&lt;b&gt;6. Farm Delivery&lt;/b&gt;&lt;br/&gt;Zone 1 / Zone 2 / Zone 3&lt;br/&gt;Precision Drip Lines&lt;br/&gt;&lt;b&gt;Soil Probe Feedback (A1)&lt;/b&gt;" vertex="1"><mxGeometry x="1200" y="340" width="200" height="110" as="geometry" /></mxCell><mxCell id="p2_e1" parent="1" edge="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#0284C7;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#0369A1;fontStyle=1;" value="Pump Pressure"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e2" parent="1" edge="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#0284C7;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#0369A1;fontStyle=1;" value="Sampled Stream"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e3" parent="1" edge="1" source="s3" target="s4_f" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#E11D48;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#BE123C;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="High TDS (&gt;500 ppm)"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e4" parent="1" edge="1" source="s3" target="s4_b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#0284C7;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#0369A1;fontStyle=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="Safe TDS (&lt;=500 ppm)"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e5" parent="1" edge="1" source="s4_f" target="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#0284C7;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#0369A1;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="Purified Effluent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e6" parent="1" edge="1" source="s4_b" target="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#0284C7;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#0369A1;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" value="Direct Clean Flow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e7" parent="1" edge="1" source="s5" target="s6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#0284C7;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#0369A1;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Enriched Solution"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_summary" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Key Hydraulic Operating Principles:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Zero Filter Clog Waste:&lt;/b&gt; Only impure water (&amp;gt; 500 ppm) is diverted through the bio-sand &amp;amp; charcoal bed.&lt;br/&gt;2. &lt;b&gt;Closed-Loop Protection:&lt;/b&gt; If soil moisture is already optimal (&amp;ge; 60%), irrigation aborts to protect roots.&lt;br/&gt;3. &lt;b&gt;Micro-Fertigation:&lt;/b&gt; Liquid nutrients are blended directly into the clean stream for immediate crop uptake." vertex="1"><mxGeometry x="60" y="340" width="1060" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-circuit" name="3. Hardware Pinout Schematic"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="850" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=16;fontColor=#FFFFFF;fontStyle=1;align=center;shadow=0;" value="&lt;b&gt;AgroFlow AI &amp;mdash; Arduino Uno Circuit Pinout &amp;amp; Wiring Diagram&lt;/b&gt;&lt;br/&gt;&lt;span st