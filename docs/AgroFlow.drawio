<mxfile host="app.diagrams.net" modified="2026-11-20T22:40:00.000Z" agent="AgroFlow Engine" version="24.0.0"><diagram id="page-overview" name="1. System Overview"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=16;fontColor=#FFFFFF;fontStyle=1;align=center;shadow=0;" value="&lt;b&gt;AgroFlow AI&lt;/b&gt; &amp;mdash; Smart Water Filtration &amp;amp; Precision Fertigation System&lt;br/&gt;&lt;span style='font-size:12px;font-weight:normal;color:#94A3B8;'&gt;End-to-End System Architecture (Cloud AI &amp;bull; Mobile App &amp;bull; IoT Hardware &amp;bull; Water Pipeline)&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="20" width="1520" height="55" as="geometry" /></mxCell><mxCell id="t1_bg" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Helvetica;fontSize=13;fontStyle=1;align=left;spacingLeft=16;strokeWidth=1.5;shadow=0;fillColor=#FAF5FF;strokeColor=#C084FC;fontColor=#6B21A8;" value="&lt;b&gt;CLOUD &amp;amp; AI INTELLIGENCE LAYER&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="95" width="1520" height="140" as="geometry" /></mxCell><mxCell id="fb_box" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Firebase Cloud Backend&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Cloud Firestore:&lt;/b&gt; Real-time telemetry sync &amp;amp; logs&lt;br/&gt;&amp;bull; &lt;b&gt;Firebase Auth:&lt;/b&gt; Farm profile &amp;amp; device management&lt;br/&gt;&amp;bull; &lt;b&gt;Cloud Functions:&lt;/b&gt; Alert triggers &amp;amp; schedule dispatch" vertex="1"><mxGeometry x="70" y="135" width="430" height="85" as="geometry" /></mxCell><mxCell id="ai_box" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#581C87;" value="&lt;b&gt;AI Agronomist Engine&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Soil Maturation Model:&lt;/b&gt; Moisture % &amp;amp; fertility scoring (64/100)&lt;br/&gt;&amp;bull; &lt;b&gt;Adaptive Scheduler:&lt;/b&gt; Weather &amp;amp; crop-stage optimized slots&lt;br/&gt;&amp;bull; &lt;b&gt;LLM Narrative:&lt;/b&gt; Automated plain-language diagnostic advice" vertex="1"><mxGeometry x="560" y="135" width="480" height="85" as="geometry" /></mxCell><mxCell id="exh_box" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;fontSize=11;align=left;spacingLeft=12;spacingRight=12;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;" value="&lt;b&gt;Exhibition &amp;amp; Operations&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Physical Model:&lt;/b&gt; Dual acrylic reservoirs &amp;amp; bio-filter&lt;br/&gt;&amp;bull; &lt;b&gt;Labels:&lt;/b&gt; Printable hardware &amp;amp; reservoir tags&lt;br/&gt;&amp;bull; &lt;b&gt;Canva Pitch Deck:&lt;/b&gt; Problem, ROI &amp;amp; Live Walkthrough" vertex="1"><mxGeometry x="1100" y="135" width="430" height="85" as="geometry" /></mxCell><mxCell id="e_t1_1" parent="1" edge="1" source="fb_box" target="ai_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontFamily=Segoe UI,Helvetica;fontSize=10;fontColor=#4338CA;fontStyle=1;" value="Telemetry Feed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_t1_2" parent="1" edge="1" source="ai_box" target="exh_box" style="edgeStyle=orthogonalEdgeStyle;rounde